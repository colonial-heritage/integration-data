###############################
# Query for generating a search graph with dataset descriptions
# Source of the query: https://triplestore.netwerkdigitaalerfgoed.nl/sparql?savedQueryName=Full%20dataset%20descriptions%20for%20publisher&owner=admin&execute
###############################

PREFIX cc: <https://colonialcollections.nl/schema#> # Internal ontology
PREFIX schema: <https://schema.org/>

CONSTRUCT {
  ?this a cc:Dataset ;
    cc:name ?name ;
    cc:license ?licenseName ;
    cc:publisher_en ?publisherNameEn ;
    cc:publisher_nl ?publisherNameNl ;
    cc:description ?description ;
    cc:keywords ?keywords .
}
WHERE {
  VALUES ?this {
    ?_iris
  }

  ####################
  # Name
  #
  # Prefer the English name; fall back to the Dutch name; then to a name
  # without a language tag. cc:name is a required property, so without this
  # fallback any dataset whose name is only available in Dutch - as the NDE
  # Dataset Register now supplies - would be dropped from the search graph.
  ####################

  ?this schema:name ?name
  FILTER(LANGMATCHES(LANG(?name), "en") || LANGMATCHES(LANG(?name), "nl") || LANG(?name) = "")
  FILTER NOT EXISTS {
    ?this schema:name ?nameWithHigherPriority
    FILTER(
      (LANGMATCHES(LANG(?nameWithHigherPriority), "en") && !LANGMATCHES(LANG(?name), "en")) ||
      (LANGMATCHES(LANG(?nameWithHigherPriority), "nl") && !LANGMATCHES(LANG(?name), "en") && !LANGMATCHES(LANG(?name), "nl"))
    )
  }

  ####################
  # License
  ####################

  ?this schema:license/schema:name ?licenseName
  FILTER(LANG(?licenseName) = "" || LANGMATCHES(LANG(?licenseName), "en"))

  ####################
  # Publisher
  ####################

  ?this schema:publisher ?publisherOrg .
  ?publisherOrg schema:name ?publisherName .

  # The KG may have multiple names per language for the same publisher (e.g. one
  # from the NDE Dataset Register and one from the data-registry). Prefer the
  # NDE Dataset Register name: exclude a name when the NDE register has a different
  # name in the same language for the same publisher.
  FILTER NOT EXISTS {
    GRAPH <https://data.colonialcollections.nl/nde-dataset-register> {
      ?publisherOrg schema:name ?ndeRegisterName .
      FILTER(LANG(?ndeRegisterName) = LANG(?publisherName))
      FILTER(?ndeRegisterName != ?publisherName)
    }
  }

  BIND(IF(LANG(?publisherName) = "en", ?publisherName, ?null) AS ?publisherNameEn)
  BIND(IF(LANG(?publisherName) = "nl", ?publisherName, ?null) AS ?publisherNameNl)

  ####################
  # Description
  ####################

  OPTIONAL {
    ?this schema:description ?description
    FILTER(LANG(?description) = "" || LANGMATCHES(LANG(?description), "en"))
  }

  ####################
  # Keywords
  ####################

  OPTIONAL {
    ?this schema:keywords ?keywords
    FILTER(LANG(?keywords) = "" || LANGMATCHES(LANG(?keywords), "en"))
  }
}
